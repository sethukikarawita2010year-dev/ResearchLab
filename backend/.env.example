# CloudConvert credentials (server-side only — never expose to the frontend).
CLOUDCONVERT_API_KEY=your_cloudconvert_key_here

# Conversion provider: "cloudconvert" (default) or "gotenberg" (self-hosted).
CONVERT_PROVIDER=cloudconvert

# Set to 1 to use the CloudConvert sandbox.
CLOUDCONVERT_SANDBOX=0

# Only used when CONVERT_PROVIDER=gotenberg.
GOTENBERG_URL=http://127.0.0.1:3000

# Gemini API key (server-side only — used for chat, structured summaries,
# web-search grounding, native PDF reading, and embeddings).
GEMINI_API_KEY=your_gemini_key_here

# PostgreSQL with pgvector. Local install default; swap for Neon/Supabase URL if using hosted.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchlab