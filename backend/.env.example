# CloudConvert credentials (server-side only — never expose to the frontend).
CLOUDCONVERT_API_KEY=your_cloudconvert_key_here

# Conversion provider: "cloudconvert" (default) or "gotenberg" (self-hosted).
CONVERT_PROVIDER=cloudconvert

# Set to 1 to use the CloudConvert sandbox.
CLOUDCONVERT_SANDBOX=0

# Only used when CONVERT_PROVIDER=gotenberg.
GOTENBERG_URL=http://127.0.0.1:3000

# OpenAI API key (server-side only — used for chat and structured summaries).
OPENAI_API_KEY=sk-...

# Model used for all AI work (summary + chat). The PDF's text is extracted
# locally (pymupdf) and sent to the model, so no file upload is needed.
# Default: gpt-4.1. gpt-4.1-mini / gpt-4.1-nano are cheaper alternatives.
# Use any model that supports structured outputs (Responses API).
OPENAI_MODEL=gpt-4.1

# Fallback model used when OPENAI_MODEL is temporarily unavailable/unusable.
# Leave blank to reuse OPENAI_MODEL.
OPENAI_FALLBACK_MODEL=

# Retry transient OpenAI errors (429 rate limits, 5xx) with exponential
# backoff before failing a turn.
OPENAI_MAX_RETRIES=4
OPENAI_RETRY_BASE_DELAY=2.0

# Self-hosted SearXNG for free web grounding (no API key). Start one with:
#   docker run -d --name searxng -p 8080:8080 searxng/searxng
# When unreachable, chat falls back to the OpenAI built-in web search tool
# (paid). Set OPENAI_NATIVE_SEARCH=0 to disable that fallback entirely.
SEARXNG_URL=http://localhost:8080
SEARXNG_TIMEOUT=6
SEARXNG_RESULTS=6
SEARXNG_SNIPPET_MAX=600
OPENAI_NATIVE_SEARCH=1

# PostgreSQL with pgvector. Local install default; swap for Neon/Supabase URL if using hosted.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchlab